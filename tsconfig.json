{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./app",
    "module": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@dash/common": ["src/lib/common/index.ts"]
    },
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/__TESTS__/static-info.test.js"],
  "exclude": ["node_modules", "tmp"],
}
